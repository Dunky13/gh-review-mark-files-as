{
  "manifest_version": 3,
  "name": "GitHub Pull Request Mark All Files as",
  "version": "1.1.1",
  "description": "Mark GitHub pull request files viewed or unviewed with custom buttons and file patterns.",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "host_permissions": ["https://github.com/**"],
  "content_scripts": [
    {
      "matches": ["https://github.com/**/pull/**"],
      "js": ["settings.js", "content.js"]
    }
  ],
  "homepage_url": "https://github.com/Dunky13/gh-review-mark-files-as",
  "icons": {
    "16": "images/icon.16.png",
    "32": "images/icon.32.png",
    "48": "images/icon.48.png",
    "64": "images/icon.64.png",
    "128":"images/icon.128.png",
    "300":"images/icon.300.png"
  },
  "action": {
    "default_title": "GitHub Pull Request Mark All Files as"
  }
}
